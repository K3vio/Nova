# Copy to .env.local and fill in what you need.

# Nova's brain. Create a key at console.anthropic.com (billed separately from Claude.ai plans).
ANTHROPIC_API_KEY=

# Where Nova stores your data. Defaults to a local SQLite file.
# DATABASE_URL=file:data/nova.db
# Only needed for a hosted Turso database.
# DATABASE_AUTH_TOKEN=
